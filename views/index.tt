<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dungeon Crawler Carl</title>
    <link href="https://cdn.jsdelivr.net/npm/beercss@3/dist/cdn/beer.min.css" rel="stylesheet">
    <link href="/dcc.css" rel="stylesheet">
    <script type="module" src="https://cdn.jsdelivr.net/npm/beercss@3/dist/cdn/beer.min.js"></script>
</head>

<body class="dark page-centered">

<div class="page-wrap center-align">

    <div class="brand">⚔️ Dungeon Crawler World</div>
    <div class="brand-sub">The apocalypse will be televised.</div>

    <div class="space"></div>

    <p>
        Good luck, Crawler, and try not to die. You're probably
        going to die.
    </p>

    <div class="space"></div>

    <a href="/login" class="button">
        <i>door_open</i>
        <span>Enter the Dungeon</span>
    </a>

</div>

</body>
</html>
