<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Enter the Dungeon</title>
    <link href="https://cdn.jsdelivr.net/npm/beercss@3/dist/cdn/beer.min.css" rel="stylesheet">
    <link href="/css/dcc.css" rel="stylesheet">
    <script type="module" src="https://cdn.jsdelivr.net/npm/beercss@3/dist/cdn/beer.min.js"></script>
    <script src="https://unpkg.com/htmx.org@2/dist/htmx.min.js"></script>
</head>

<body class="dark page-centered">

<div class="page-wrap">

    <div class="brand">⚔️ Dungeon Crawler World</div>
    <div class="brand-sub">Identify yourself, Crawler.</div>

    <div id="login-error">[% error %]</div>

    <!--
        On success: server sets HX-Redirect → browser navigates to /.
        On failure: server returns 401 + error string → swapped into #login-error.
    -->
    <form hx-post="/login"
          hx-target="#login-error"
          hx-swap="innerHTML"
          hx-on::before-request="document.getElementById('login-error').textContent = ''">

        <div class="field label border">
            <input type="text" name="username" autocomplete="username" required>
            <label>Username</label>
        </div>

        <div class="field label border">
            <input type="password" name="password" autocomplete="current-password" required>
            <label>Password</label>
        </div>

        <div class="space"></div>

        <button type="submit" class="responsive">
            <i>door_open</i>
            <span>Enter the Dungeon</span>
        </button>

    </form>

</div>

</body>
</html>
